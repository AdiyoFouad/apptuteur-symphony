{% extends 'base.html.twig' %}
{% import 'macros/badges.html.twig' as ui %}

{% block title %}Sujets de stage{% endblock %}

{% block body %}

<h2 class="mb-4">Liste des sujets de stage</h2>

{# ---- FILTRE ENTREPRISE ---- #}
<form method="get" class="mb-4">
    <label for="entreprise">Filtrer par entreprise :</label>
    <select name="entreprise" id="entreprise" onchange="this.form.submit()">
        <option value="">Toutes</option>
        {% for e in entreprises %}
            <option value="{{ e }}" {{ filtre == e ? 'selected' : '' }}>
                {{ e }}
            </option>
        {% endfor %}
    </select>
</form>

{# ---- AFFICHE LES SUJETS ---- #}

{% if sujets is empty %}
    <p class="text-muted">Aucun sujet trouvé.</p>
{% else %}
    <ul class="list-group">
        {% for s in sujets %}
            <li class="list-group-item">
                {{ ui.badge(s.sujet) }}  
                <br>
                <strong>{{ s.etudiant }}</strong>
                <span class="text-muted"> — Tuteur : {{ s.tuteur }}</span>
                <br>
                <small class="text-muted">Entreprise : {{ s.entreprise }}</small>
            </li>
        {% endfor %}
    </ul>
{% endif %}

{% endblock %}
