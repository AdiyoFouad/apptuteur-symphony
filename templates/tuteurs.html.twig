{# templates/tuteurs.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}
    Liste des tuteurs
{% endblock %}

{% block body %}
    <h1>Liste des tuteurs</h1>

    {% if tuteurs is not empty %}
        <ul>
            {% for tuteur in tuteurs %}
                <li>{{ tuteur.nom }} {{ tuteur.prenom }}</li>
            {% endfor %}
        </ul>
    {% else %}
        <p>Aucun tuteur trouvé.</p>
    {% endif %}
{% endblock %}
